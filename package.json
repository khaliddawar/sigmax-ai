{
  "name": "sigmax-ai",
  "version": "1.0.0",
  "description": "A powerful Chrome extension that captures trading signals and chat discussions from various platforms and streams structured data to backend webhooks for AI analysis",
  "main": "src/background/service-worker.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/khaliddawar/sigmax-ai.git"
  },
  "homepage": "https://github.com/khaliddawar/sigmax-ai",
  "bugs": {
    "url": "https://github.com/khaliddawar/sigmax-ai/issues"
  },
  "scripts": {
    "dev": "webpack --config config/webpack.config.js --mode development --watch",
    "build": "webpack --config config/webpack.config.js --mode production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,json,css,html}\"",
    "package": "npm run build && node scripts/package.js",
    "clean": "rimraf build dist coverage"
  },
  "keywords": [
    "chrome-extension",
    "webhook",
    "chat-monitor",
    "discord",
    "telegram",
    "automation"
  ],
  "author": "SignalScope",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "ajv": "^8.17.1",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.4.2",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "jest-chrome": "^0.8.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.7.6",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.5",
    "sinon": "^16.1.0",
    "sinon-chrome": "^3.0.1",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0",
    "zip-webpack-plugin": "^4.0.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "jest-chrome"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/**/*.spec.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "moduleNameMapper": {
      "^@background/(.*)$": "<rootDir>/src/background/$1",
      "^@content/(.*)$": "<rootDir>/src/content/$1",
      "^@popup/(.*)$": "<rootDir>/src/popup/$1",
      "^@options/(.*)$": "<rootDir>/src/options/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@assets/(.*)$": "<rootDir>/src/assets/$1"
    }
  }
}
