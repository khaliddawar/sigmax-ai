SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5wZHh4ZWZvaGViaGFidHJyeWJvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1MTAyNzQ1OCwiZXhwIjoyMDY2NjAzNDU4fQ.xBDtULhyIB6NStJFsn1h1Dz2U2vGjHSZnQFAghGQz38

# === AI API KEYS ===
# OpenAI for embeddings and chat
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic for Claude (primary AI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Perplexity for research (optional)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# === EMAIL SERVICE ===
# Postmark for professional email delivery
POSTMARK_API_TOKEN=your_postmark_api_token_here
POSTMARK_FROM_EMAIL=noreply@yourdomain.com

# === REDIS CONFIGURATION ===
# Redis for job queue and caching
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_if_needed

# === SECURITY ===
# JWT configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# === YOUTUBE EXTENSION SPECIFIC ===
# Chrome extension ID for CORS
CHROME_EXTENSION_ID=your_chrome_extension_id_here

# === ENVIRONMENT ===
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# === OPTIONAL SERVICES ===
# Google API (for additional YouTube metadata)
GOOGLE_API_KEY=your_google_api_key_here

# Mistral AI (alternative model)
MISTRAL_API_KEY=your_mistral_api_key_here

# === FILE STORAGE ===
# Local file storage paths
TRANSCRIPT_STORAGE_PATH=./data/transcripts
SUMMARY_STORAGE_PATH=./data/summaries

# === RATE LIMITING ===
# API rate limiting configuration
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# === CORS CONFIGURATION ===
# Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://your-extension-id

# === DATABASE ===
# Additional database configuration if needed
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20 