# ===================================================================
# Simply Chrome Extension - PRODUCTION Environment Configuration
# This file contains production-ready environment variable templates
# ===================================================================

# === ENVIRONMENT ===
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# === SUPABASE CONFIGURATION ===
# Get these from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# === AUTHENTICATION & SECURITY ===
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=REPLACE_WITH_STRONG_PRODUCTION_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
BCRYPT_ROUNDS=12

# === PADDLE PAYMENT SYSTEM (PRODUCTION) ===
# Get these from: https://paddle.com → Developer Tools → Authentication
PADDLE_VENDOR_ID=123456
PADDLE_API_KEY=your_production_paddle_api_key
PADDLE_PUBLIC_KEY=your_production_paddle_public_key
PADDLE_WEBHOOK_SECRET=your_production_paddle_webhook_secret
PADDLE_ENVIRONMENT=production
# Production Product IDs
PADDLE_PRODUCT_ID_PREMIUM=prod_123456
PADDLE_PRODUCT_ID_ENTERPRISE=prod_123457

# === EMAIL SERVICE (PRODUCTION) ===
# Postmark (Recommended for production)
POSTMARK_API_TOKEN=your_production_postmark_token
POSTMARK_SENDER_EMAIL=noreply@yourdomain.com
POSTMARK_SENDER_NAME=Simply

# === AI SERVICES ===
# OpenAI (Required)
OPENAI_API_KEY=sk-proj-your_production_openai_key
OPENAI_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large

# Anthropic (Optional but recommended)
ANTHROPIC_API_KEY=sk-ant-your_production_anthropic_key
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Perplexity (Optional - for research features)
PERPLEXITY_API_KEY=pplx-your_production_perplexity_key

# === REDIS CONFIGURATION (PRODUCTION) ===
# Production Redis service
REDIS_URL=rediss://username:password@your-redis-host:6380
REDIS_HOST=your-redis-host
REDIS_PORT=6380
REDIS_PASSWORD=your_strong_redis_password
REDIS_DB=0

# === CORS & SECURITY (PRODUCTION) ===
ALLOWED_ORIGINS=https://yourdomain.com,chrome-extension://your_published_extension_id
CHROME_EXTENSION_ID=your_published_extension_id_from_chrome_store
FRONTEND_URL=https://yourdomain.com

# === API CONFIGURATION ===
API_HOST=0.0.0.0
API_PORT=8000

# === MONITORING & ANALYTICS ===
# Optional: Add monitoring services
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ANALYTICS_API_KEY=your_analytics_api_key

# === RATE LIMITING (PRODUCTION) ===
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
RATE_LIMIT_ENABLED=true

# === BACKUP & RECOVERY ===
# Optional: Backup service configuration
BACKUP_SERVICE_URL=https://your-backup-service.com
BACKUP_API_KEY=your_backup_api_key

# === SSL & SECURITY HEADERS ===
FORCE_HTTPS=true
SECURE_COOKIES=true
CSRF_PROTECTION=true

# === LEGACY SETTINGS (for backward compatibility) ===
QA_MODEL=gpt-4o-mini 