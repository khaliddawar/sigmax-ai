# === AUTHENTICATION & SECURITY ===
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-production-jwt-secret-generate-new-one
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
BCRYPT_ROUNDS=12

# === EMAIL CONFIGURATION (Gmail SMTP) ===
# Using your current Gmail setup
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SENDER_EMAIL=your-gmail-address@gmail.com

# === AI SERVICES ===
# OpenAI (Required)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large

# Anthropic (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# === CORS & SECURITY ===
# Update with your actual Chrome extension ID after publishing
ALLOWED_ORIGINS=chrome-extension://your-published-extension-id
CHROME_EXTENSION_ID=your-published-extension-id
FRONTEND_URL=https://simply-firy.onrender.com

# === API CONFIGURATION ===
API_HOST=0.0.0.0
API_PORT=8000

# === REDIS CONFIGURATION (Optional for now) ===
# Can use in-memory storage initially
REDIS_URL=redis://localhost:6379

# === FEATURE FLAGS ===
# Disable payment features
ENABLE_PAYMENTS=false
ENABLE_PADDLE=false

# === LEGACY SETTINGS ===
QA_MODEL=gpt-4o-mini 