# Pipeline Split Feature Configuration
# ===========================================
# 
# SAFETY: Feature starts DISABLED by default
# All users continue to get full pipeline (current behavior)
# No functionality changes until explicitly enabled
#
# To enable pipeline split (after testing):
# ENABLE_PREMIUM_PIPELINE_SPLIT=true
#
# Current setting: DISABLED for safety
ENABLE_PREMIUM_PIPELINE_SPLIT=false

# Documentation:
# - When false: All users get full pipeline (embeddings + semantic chunks + summary)
# - When true: Premium users get full pipeline, Free users get summary only
# - Free users save ~2-3 OpenAI API calls per transcript
# - Premium users: premium, pro, enterprise plans
# - Free users: free, trial plans 