# FastAPI Configuration
APP_NAME=SignalScope Backend
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
WEBHOOK_SECRET=your-webhook-hmac-secret-here
CORS_ORIGINS=["http://localhost:3000", "chrome-extension://*"]

# Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Redis
REDIS_URL=redis://localhost:6379/0
# For Redis Cloud: redis://default:password@redis-host:port

# LLM Providers
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# LLM Configuration
DEFAULT_LLM_PROVIDER=openai  # or anthropic
DEFAULT_LLM_MODEL=gpt-3.5-turbo  # or gpt-4, claude-3-sonnet
MAX_TOKENS_PER_REQUEST=4000
LLM_TEMPERATURE=0.3

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Report Generation
REALTIME_BATCH_SECONDS=300  # 5 minutes
STANDARD_BATCH_SECONDS=900  # 15 minutes
ARCHIVE_BATCH_SECONDS=3600  # 1 hour

# Monitoring
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090

# Email (Optional)
EMAIL_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password